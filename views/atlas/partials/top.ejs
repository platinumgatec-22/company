<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#06090f">
  <title><%= title %> · Atlas · <%= company %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&family=Unbounded:wght@500;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/atlas.css">
</head>
<body class="atlas <%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-orbit" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(-25 12 12)"/></symbol>
  <symbol id="i-board" viewBox="0 0 24 24"><rect x="3" y="4" width="5" height="16" rx="1.5"/><rect x="10" y="4" width="5" height="11" rx="1.5"/><rect x="17" y="4" width="4" height="7" rx="1.5"/></symbol>
  <symbol id="i-cal" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></symbol>
  <symbol id="i-canvas" viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/><path d="M11 7h4a2 2 0 0 1 2 2v4"/></symbol>
  <symbol id="i-clients" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c2 .7 3.2 2.4 3.5 5.2"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 19.5 5.3 16A8 8 0 1 1 8 18.8z"/><path d="M9 10.5c.3 1.8 2 3.6 4 4l1-1.2 2 .9"/></symbol>
  <symbol id="i-team" viewBox="0 0 24 24"><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/></symbol>
  <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></symbol>
  <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7z"/><path d="M19 15.5c.3 1.8 1 2.5 2.5 2.8-1.5.3-2.2 1-2.5 2.7-.3-1.7-1-2.4-2.5-2.7 1.5-.3 2.2-1 2.5-2.8z"/></symbol>
  <symbol id="i-pulse" viewBox="0 0 24 24"><path d="M3 12h4l2-6 4 12 2-6h6"/></symbol>
</svg>

<header class="a-top">
  <a href="/atlas" class="a-brand" aria-label="Atlas">
    <span class="a-brand-mark"></span>
    <span class="a-brand-word">ATLAS</span>
    <span class="a-brand-sub"><%= company %></span>
  </a>
  <div class="a-top-end">
    <a href="/departments" class="a-link-quiet">بوابة الموظفين</a>
    <% if (user.role === 'admin') { %><a href="/admin/employees" class="a-link-quiet">الإدارة</a><% } %>
    <a href="/profile" class="a-me" title="حسابي">
      <span class="a-avatar" style="background:<%= avatarColor(user.id) %>"><%= initials(user.full_name) %></span>
      <span class="a-me-name"><%= user.full_name %></span>
    </a>
    <form method="post" action="/logout" class="inline"><button class="a-btn a-btn-ghost a-btn-sm mono">SIGN OUT</button></form>
  </div>
</header>

<% const nav = [
  ['/atlas', 'i-orbit', 'المدار', 'exact'],
  ['/atlas/board', 'i-board', 'المهام'],
  ['/atlas/calendar', 'i-cal', 'التقويم'],
  ['/atlas/canvas', 'i-canvas', 'اللوحات'],
  ['/atlas/clients', 'i-clients', 'العملاء'],
  ['/atlas/inbox', 'i-chat', 'واتساب', badges.inbox],
  ['/atlas/strategist', 'i-spark', 'المستشار', badges.proposals],
  ['/atlas/activity', 'i-pulse', 'النشاط'],
];
if (user.role === 'admin') nav.push(['/atlas/automations', 'i-bolt', 'الأتمتة']);
const full = path.replace(/\/$/, '') || '/'; %>
<nav class="a-side" aria-label="Atlas">
  <% nav.forEach(([href, icon, label, extra]) => {
       const active = extra === 'exact' ? full === href : full.startsWith(href) || (href === '/atlas/board' && full.startsWith('/atlas/tasks')); %>
    <a href="<%= href %>" class="<%= active ? 'active' : '' %>">
      <svg class="a-ico"><use href="#<%= icon %>"/></svg>
      <span><%= label %></span>
      <% if (typeof extra === 'number' && extra > 0) { %><b class="a-badge"><%= extra %></b><% } %>
    </a>
  <% }) %>
</nav>

<main class="a-main">
<% if (flash) { %><div class="a-flash a-flash-<%= flash.type %>"><%= flash.message %></div><% } %>
