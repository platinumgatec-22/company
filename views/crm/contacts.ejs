<%- include('../partials/header') %>
<section class="section crm-section">
  <div class="container">
    <%- include('_tabs') %>
    <div class="page-head">
      <div>
        <h1 class="h2">جهات الاتصال</h1>
        <p class="muted"><%= contacts.length %> جهة اتصال</p>
      </div>
      <div class="actions">
        <form class="search">
          <input name="q" value="<%= search %>" placeholder="ابحث بالاسم أو الشركة أو الهاتف…" aria-label="بحث">
          <button class="btn btn-ghost">بحث</button>
        </form>
        <a class="btn btn-primary" href="<%= base %>/crm/contacts/new">+ جهة اتصال</a>
      </div>
    </div>
    <% if (contacts.length === 0) { %>
      <div class="empty">لا توجد نتائج.</div>
    <% } else { %>
      <div class="table-wrap card">
        <table class="table">
          <thead><tr><th>الاسم</th><th>الشركة</th><th>المصدر</th><th>الصفقات</th><th>مفتوح</th><th>تم الفوز</th><th>المسؤول</th></tr></thead>
          <tbody>
            <% contacts.forEach(c => { %>
              <tr>
                <td>
                  <a href="<%= base %>/crm/contacts/<%= c.id %>" class="cell-user">
                    <span class="avatar avatar-xs" style="background:<%= avatarColor(c.id) %>"><%= initials(c.full_name) %></span>
                    <span><strong><%= c.full_name %></strong><br><span class="muted small"><%= c.job_title %></span></span>
                  </a>
                </td>
                <td><%= c.company || '—' %></td>
                <td><span class="chip"><%= crm.sourceMap[c.source].label %></span></td>
                <td class="num"><%= c.deal_count %></td>
                <td class="num"><%= c.open_value ? crm.money(c.open_value) : '—' %></td>
                <td class="num won-text"><%= c.won_value ? crm.money(c.won_value) : '—' %></td>
                <td class="small"><%= c.owner_name || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
