<%- include('../partials/header') %>
<% const esc = (t) => String(t).replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);
   const hbars = (list, empty) => list.length === 0 ? `<p class="muted small">${empty}</p>` : '<ul class="hbars">' + list.map(g =>
  `<li><div class="hbar-top"><span>${esc(g.label)} <span class="muted small">(${g.count})</span></span><strong class="num">${crm.money(g.value)}</strong></div>` +
  `<div class="hbar"><span style="--w:${g.pct}%"></span></div></li>`).join('') + '</ul>'; %>
<section class="section crm-section">
  <div class="container">
    <%- include('_tabs') %>
    <div class="page-head">
      <div>
        <h1 class="h2">التقارير</h1>
        <p class="muted">منذ <%= s.start %></p>
      </div>
      <div class="segmented" role="group" aria-label="الفترة">
        <% [['month', 'هذا الشهر'], ['quarter', 'هذا الربع'], ['year', 'هذه السنة']].forEach(([k, label]) => { %>
          <a href="?period=<%= k %>" class="<%= period === k ? 'active' : '' %>"><%= label %></a>
        <% }) %>
      </div>
    </div>

    <div class="kpis">
      <div class="kpi kpi-hero">
        <span class="kpi-label">الإيرادات (تم الفوز)</span>
        <strong class="kpi-value num" data-count="<%= s.wonValue %>"><%= crm.moneyFull(s.wonValue) %></strong>
        <span class="kpi-unit">د.ك</span>
        <span class="kpi-sub"><%= s.won.length %> صفقة</span>
      </div>
      <div class="kpi"><span class="kpi-label">صفقات مُغلقة</span><strong class="kpi-value num"><%= s.won.length + s.lost.length %></strong><span class="kpi-sub"><%= s.lost.length %> خسارة</span></div>
      <div class="kpi"><span class="kpi-label">متوسط الصفقة</span><strong class="kpi-value num"><%= crm.money(s.avgDeal) %></strong><span class="kpi-sub">د.ك</span></div>
      <div class="kpi"><span class="kpi-label">متوسط دورة البيع</span><strong class="kpi-value num"><%= s.avgCycle %></strong><span class="kpi-sub">يوم</span></div>
    </div>

    <div class="crm-grid">
      <div class="card panel span-wide">
        <div class="panel-head"><h2 class="h3">الإيرادات الشهرية</h2><span class="muted small">د.ك</span></div>
        <% const maxMonth = Math.max(1, ...months.map(x => x.value)); %>
        <div class="bars" role="img" aria-label="الإيرادات الشهرية">
          <% months.forEach((mo, i) => { %>
            <div class="bar-col">
              <span class="bar-val num"><%= crm.money(mo.value) %></span>
              <div class="bar <%= i === months.length - 1 ? 'bar-current' : '' %>" style="--h:<%= Math.round(mo.value / maxMonth * 100) %>%"></div>
              <span class="bar-label"><%= mo.label %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="card panel">
        <div class="panel-head"><h2 class="h3">نسبة الفوز</h2></div>
        <div class="donut" style="--p:<%= s.winRate %>" role="img" aria-label="نسبة الفوز <%= s.winRate %>%">
          <span><strong class="num"><%= s.winRate %>%</strong><small class="muted"><%= s.won.length %> فوز / <%= s.lost.length %> خسارة</small></span>
        </div>
      </div>

      <div class="card panel"><div class="panel-head"><h2 class="h3">حسب النوع</h2></div><%- hbars(byType, 'لا توجد صفقات فائزة في هذه الفترة.') %></div>
      <div class="card panel"><div class="panel-head"><h2 class="h3">حسب المصدر</h2></div><%- hbars(bySource, 'لا توجد صفقات فائزة في هذه الفترة.') %></div>
      <div class="card panel"><div class="panel-head"><h2 class="h3">حسب الموظف</h2></div><%- hbars(byOwner, 'لا توجد صفقات فائزة في هذه الفترة.') %></div>
      <div class="card panel span-wide"><div class="panel-head"><h2 class="h3">خط المبيعات المفتوح حسب المرحلة</h2><span class="muted small">الآن</span></div><%- hbars(pipeline, 'لا توجد صفقات مفتوحة.') %></div>
    </div>
  </div>
</section>
<script src="<%= base %>/js/crm.js" defer></script>
<%- include('../partials/footer') %>
