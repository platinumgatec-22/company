<%- include('../partials/header') %>
<section class="section crm-section">
  <div class="container narrow-lg">
    <%- include('_tabs') %>
    <a class="back" href="<%= base %>/crm/contacts<%= contact.id ? `/${contact.id}` : '' %>">→ رجوع</a>
    <div class="card form-card">
      <h1 class="h2"><%= title %></h1>
      <form method="post" action="<%= base %>/crm/contacts<%= contact.id ? `/${contact.id}` : '' %>" class="form">
        <div class="form-grid">
          <label>الاسم الكامل <input name="full_name" value="<%= contact.full_name %>" required maxlength="100"></label>
          <label>الشركة / الجهة <input name="company" value="<%= contact.company %>" maxlength="100"></label>
          <label>المسمى الوظيفي <input name="job_title" value="<%= contact.job_title %>" maxlength="100"></label>
          <label>المصدر
            <select name="source">
              <% crm.SOURCES.forEach(s => { %><option value="<%= s.key %>" <%= s.key === contact.source ? 'selected' : '' %>><%= s.label %></option><% }) %>
            </select>
          </label>
          <label>البريد الإلكتروني <input name="email" type="email" dir="ltr" value="<%= contact.email %>"></label>
          <label>الهاتف <input name="phone" type="tel" dir="ltr" value="<%= contact.phone %>" placeholder="+965"></label>
          <label class="span-2">ملاحظات <textarea name="notes" rows="3" maxlength="1000"><%= contact.notes %></textarea></label>
        </div>
        <div class="card-actions">
          <button class="btn btn-primary">حفظ</button>
          <a class="btn btn-ghost" href="<%= base %>/crm/contacts">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
