<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-inner">
    <div>
      <p class="eyebrow"><%= companyEn %> · الكويت</p>
      <h1>نصنع البطولات <span class="accent">ونصنع الأبطال</span></h1>
      <p class="lead"><%= company %> جهة متخصصة في تنظيم البطولات الرياضية في الكويت: من فكرة البطولة والتسجيل، إلى الملاعب والرعاة والجوائز والتغطية الإعلامية.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-primary">خدماتنا</a>
        <a href="#contact" class="btn btn-ghost-light">تواصل معنا</a>
      </div>
    </div>
    <div class="hero-side">
      <img src="/img/logo-white.png" alt="<%= company %>" class="hero-logo" width="172" height="200">
      <div class="hero-stats">
        <div class="stat"><strong><%= stats.departments %></strong><span>إدارات</span></div>
        <div class="stat"><strong><%= stats.employees %></strong><span>عضو في الفريق</span></div>
        <div class="stat"><strong><%= stats.digital %></strong><span>موظف رقمي</span></div>
      </div>
    </div>
  </div>
</section>

<section id="services" class="section">
  <div class="container">
    <h2>خدماتنا</h2>
    <p class="muted">كل ما تحتاجه البطولة في مكان واحد.</p>
    <div class="grid grid-3">
      <div class="card service"><span class="dept-icon">🏆</span><h3>تنظيم البطولات</h3><p class="muted">بطولات للأفراد والمجموعات والشركات: الجداول والقرعة والحكام والنتائج والجوائز.</p></div>
      <div class="card service"><span class="dept-icon">🏟️</span><h3>تشغيل الملاعب</h3><p class="muted">إدارة وتشغيل الملاعب والمنشآت الرياضية وحجوزاتها.</p></div>
      <div class="card service"><span class="dept-icon">⛺</span><h3>المعسكرات الرياضية</h3><p class="muted">معسكرات تدريبية للفرق والأفراد بإشراف متخصصين.</p></div>
      <div class="card service"><span class="dept-icon">🤝</span><h3>الرعايات والشراكات</h3><p class="muted">باقات رعاية للشركات تضمن حضور علامتها في البطولات وتغطيتها.</p></div>
      <div class="card service"><span class="dept-icon">📝</span><h3>التسجيل والاشتراك</h3><p class="muted">تسجيل الفرق واللاعبين ومتابعة الاشتراكات بسهولة عبر واتساب.</p></div>
      <div class="card service"><span class="dept-icon">📣</span><h3>التغطية الإعلامية</h3><p class="muted">محتوى وتصاميم وفيديو ونشر يومي على حساباتنا في وسائل التواصل.</p></div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2>الرياضات</h2>
    <div class="chips sports">
      <span class="chip">🎾 بادل</span><span class="chip">⚽ كرة القدم</span><span class="chip">🏖️ كرة القدم الشاطئية</span>
      <span class="chip">🏃 ماراثون</span><span class="chip">🏀 كرة السلة</span><span class="chip">🏐 الكرة الطائرة</span><span class="chip">🎾 التنس</span>
    </div>
  </div>
</section>

<section id="about" class="section">
  <div class="container two-col">
    <div>
      <h2>من نحن</h2>
      <p>البوابة البلاتينية فريق يجمع الخبرة الرياضية والتنظيمية مع فريق من الموظفين الرقميين يعملون على مدار الساعة: خدمة العملاء، التسويق والمحتوى، الرعايات، العمليات، المالية والقانونية.</p>
      <p>هدفنا أن تكون كل بطولة تجربة احترافية للاعبين والجمهور والرعاة، من أول رسالة تسجيل حتى تتويج الأبطال.</p>
    </div>
    <ul class="values">
      <li><span>🎯</span><div><strong>الاحترافية</strong><p class="muted">تنظيم دقيق وجداول واضحة ونتائج فورية.</p></div></li>
      <li><span>⚡</span><div><strong>السرعة</strong><p class="muted">رد فوري على العملاء وفريق يعمل 24 ساعة.</p></div></li>
      <li><span>🤝</span><div><strong>الشراكة</strong><p class="muted">قيمة حقيقية للرعاة والشركاء في كل بطولة.</p></div></li>
    </ul>
  </div>
</section>

<section id="departments" class="section section-alt">
  <div class="container">
    <h2>إداراتنا</h2>
    <div class="grid grid-3">
      <% departments.forEach(d => { %>
        <a class="card dept-card" href="/departments/<%= d.id %>">
          <span class="dept-icon"><%= d.icon %></span>
          <h3><%= d.name %></h3>
          <p class="muted"><%= d.description %></p>
          <span class="chip"><%= d.employee_count %> عضو</span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section id="contact" class="section">
  <div class="container two-col">
    <div>
      <h2>تواصل معنا</h2>
      <p class="muted">للاشتراك في البطولات، أو تنظيم بطولة لشركتك، أو الرعاية.</p>
      <ul class="contact-list">
        <li>📍 الكويت</li>
        <li>✉️ <a href="mailto:<%= contactEmail %>" dir="ltr"><%= contactEmail %></a></li>
        <li>📸 <a href="https://instagram.com/<%= instagram %>" target="_blank" rel="noopener" dir="ltr">@<%= instagram %></a></li>
      </ul>
    </div>
    <div class="card cta-card">
      <img src="/img/logo.png" alt="" width="56" height="65" class="cta-logo">
      <h3>بوابة الفريق</h3>
      <p class="muted">دخول الإدارة والفريق: الأقسام، سير النشر، البطولات، الفواتير، وبوابة القرارات.</p>
      <a href="<%= user ? '/departments' : '/login' %>" class="btn btn-primary">الدخول إلى البوابة</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
