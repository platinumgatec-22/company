<%- include('../partials/header') %>
<section class="section">
  <div class="container narrow-lg">
    <%- include('tabs') %>
    <div class="card form-card">
      <h1 class="h2"><%= title %></h1>
      <form method="post" action="<%= base %>/admin/employees<%= employee.id ? '/' + employee.id : '' %>" class="form">
        <div class="form-grid">
          <label>الاسم الكامل *<input name="full_name" value="<%= employee.full_name %>" required></label>
          <label>اسم المستخدم (للدخول) *<input name="username" value="<%= employee.username %>" required dir="ltr" pattern="[a-zA-Z0-9._\-]{3,32}"></label>
          <label>المسمى الوظيفي<input name="job_title" value="<%= employee.job_title %>"></label>
          <label>القسم
            <select name="department_id">
              <option value="">— بدون قسم —</option>
              <% departments.forEach(d => { %>
                <option value="<%= d.id %>" <%= d.id === employee.department_id ? 'selected' : '' %>><%= d.icon %> <%= d.name %></option>
              <% }) %>
            </select>
          </label>
          <label>البريد الإلكتروني<input name="email" type="email" value="<%= employee.email %>" dir="ltr"></label>
          <label>الهاتف<input name="phone" value="<%= employee.phone %>" dir="ltr"></label>
          <label>تاريخ التعيين<input name="hire_date" type="date" value="<%= employee.hire_date %>"></label>
          <label>الصلاحية
            <select name="role">
              <option value="employee" <%= employee.role === 'employee' ? 'selected' : '' %>>موظف</option>
              <option value="admin" <%= employee.role === 'admin' ? 'selected' : '' %>>مدير النظام</option>
            </select>
          </label>
          <label class="span-2">نبذة<textarea name="bio" rows="3" maxlength="500"><%= employee.bio %></textarea></label>
          <label class="span-2"><%= employee.id ? 'إعادة تعيين كلمة المرور (اتركها فارغة لعدم التغيير)' : 'كلمة المرور المبدئية *' %>
            <input name="password" type="text" <%= employee.id ? '' : 'required' %> minlength="6" autocomplete="new-password" dir="ltr">
            <span class="muted small">سيُطلب من الموظف تغييرها عند أول دخول.</span>
          </label>
        </div>
        <div class="checks">
          <label class="check"><input type="checkbox" name="is_manager" value="1" <%= employee.is_manager ? 'checked' : '' %>> رئيس القسم</label>
          <label class="check"><input type="checkbox" name="is_active" value="1" <%= employee.is_active ? 'checked' : '' %>> الحساب نشط</label>
        </div>
        <div class="card-actions">
          <button class="btn btn-primary">حفظ</button>
          <a class="btn btn-ghost" href="<%= base %>/admin/employees">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
