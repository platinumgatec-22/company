<%- include('partials/header') %>
<section class="section">
  <div class="container narrow-lg">
    <% if (employee.department_id) { %>
      <a href="/departments/<%= employee.department_id %>" class="back">→ <%= employee.department_name %></a>
    <% } %>
    <div class="card profile-card">
      <div class="profile-head">
        <span class="avatar avatar-lg" style="background:<%= avatarColor(employee.id) %>"><%= initials(employee.full_name) %></span>
        <div>
          <h1 class="h2"><%= employee.full_name %></h1>
          <p class="muted"><%= employee.job_title || '—' %></p>
          <div class="chips">
            <% if (employee.department_name) { %><span class="chip"><%= employee.department_icon %> <%= employee.department_name %></span><% } %>
            <% if (employee.is_manager) { %><span class="badge badge-gold">رئيس القسم</span><% } %>
            <% if (employee.is_digital) { %><span class="badge badge-digital">🤖 موظف رقمي</span><% } %>
            <% if (employee.role === 'admin') { %><span class="badge">مدير النظام</span><% } %>
            <% if (!employee.is_active) { %><span class="badge badge-red">غير نشط</span><% } %>
          </div>
        </div>
      </div>
      <dl class="details">
        <div><dt>البريد الإلكتروني</dt><dd><% if (employee.email) { %><a href="mailto:<%= employee.email %>" dir="ltr"><%= employee.email %></a><% } else { %>—<% } %></dd></div>
        <div><dt>الهاتف</dt><dd><% if (employee.phone) { %><a href="tel:<%= employee.phone.replace(/\s/g, '') %>" dir="ltr"><%= employee.phone %></a><% } else { %>—<% } %></dd></div>
        <div><dt>اسم المستخدم</dt><dd dir="ltr"><%= employee.username %></dd></div>
        <div><dt>تاريخ التعيين</dt><dd><%= employee.hire_date || '—' %></dd></div>
        <% if (employee.instagram_account) { %>
          <div><dt>حساب إنستقرام</dt><dd><a href="https://instagram.com/<%= employee.instagram_account %>" target="_blank" rel="noopener" dir="ltr">@<%= employee.instagram_account %></a></dd></div>
        <% } %>
        <% if (employee.buffer_user) { %><div><dt>مستخدم Buffer</dt><dd dir="ltr"><%= employee.buffer_user %></dd></div><% } %>
      </dl>
      <% if (employee.bio) { %><div class="bio"><h3>نبذة</h3><p><%= employee.bio %></p></div><% } %>
      <% if (scenarios || makeError) { %>
        <div class="bio">
          <h3>⚙️ عمله في Make</h3>
          <% if (makeError) { %><p class="muted"><%= makeError %></p>
          <% } else if (!scenarios.length) { %><p class="muted">لا توجد سيناريوهات باسمه في Make.</p>
          <% } else { %>
            <ul class="scenarios">
              <% scenarios.forEach(s => { %>
                <li>
                  <div><strong><%= s.name.split(' - ').slice(1).join(' - ') || s.name %></strong>
                    <span class="muted small">مرات التشغيل: <%= s.executions %><% if (s.nextExec) { %> · التشغيل القادم: <span dir="ltr"><%= String(s.nextExec).slice(0, 16).replace('T', ' ') %></span><% } %></span></div>
                  <div class="chips">
                    <% if (!s.active || s.paused) { %><span class="badge">متوقف</span><% } else { %><span class="badge badge-green">يعمل</span><% } %>
                    <% if (s.errors) { %><span class="badge badge-red"><%= s.errors %> أخطاء</span><% } %>
                    <% if (s.url) { %><a class="small" href="<%= s.url %>" target="_blank" rel="noopener">فتح في Make ↗</a><% } %>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% } %>
      <% if (user.role === 'admin') { %>
        <div class="card-actions"><a class="btn btn-ghost" href="/admin/employees/<%= employee.id %>/edit">تعديل</a></div>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
