<%- include('partials/header') %>
<section class="section">
  <div class="container">
    <div class="page-head">
      <div>
        <h1 class="h2">دليل الموظفين</h1>
        <p class="muted"><%= employees.length %> نتيجة</p>
      </div>
      <form class="search">
        <input name="q" value="<%= search %>" placeholder="الاسم، المسمى الوظيفي، البريد…">
        <select name="department">
          <option value="">كل الأقسام</option>
          <% departments.forEach(d => { %>
            <option value="<%= d.id %>" <%= d.id === deptId ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
        <button class="btn btn-primary">بحث</button>
      </form>
    </div>
    <% if (employees.length === 0) { %>
      <div class="empty">لا توجد نتائج.</div>
    <% } else { %>
      <div class="grid grid-3">
        <% employees.forEach(e => { %><%- include('partials/employee-card', { e, showDept: true }) %><% }) %>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
