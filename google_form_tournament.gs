// ينشئ Google Form كامل لاستبيان تنظيم البطولة
// الطريقة: افتح script.google.com > New project > الصق هذا الكود > Run
function createTournamentForm() {
  var form = FormApp.create('استبيان تنظيم بطولة');
  form.setDescription('نرجو تعبئة البيانات التالية لنتمكن من إعداد عرض متكامل للبطولة');
  form.setCollectEmail(false);

  function text(t, req) { form.addTextItem().setTitle(t).setRequired(!!req); }
  function para(t) { form.addParagraphTextItem().setTitle(t); }
  function one(t, opts, other) { var i = form.addMultipleChoiceItem().setTitle(t).setChoiceValues(opts); if (other) i.showOtherOption(true); }
  function many(t, opts, other) { var i = form.addCheckboxItem().setTitle(t).setChoiceValues(opts); if (other) i.showOtherOption(true); }
  function section(t) { form.addPageBreakItem().setTitle(t); }

  // 1
  form.addSectionHeaderItem().setTitle('1. معلومات أساسية');
  text('اسم العميل أو الجهة المنظِّمة', true);
  text('اسم البطولة المقترح');
  many('الهدف من البطولة', ['ترفيهي', 'تنافسي', 'تسويقي / رعاية', 'خيري', 'داخلي للموظفين'], true);
  one('هل نُظّمت البطولة من قبل؟', ['نعم', 'لا']);
  para('إذا نعم، ما الملاحظات على البطولة السابقة؟');

  section('2. نوع البطولة');
  one('الرياضة أو اللعبة', ['كرة قدم', 'بادل', 'كرة سلة', 'كرة طائرة', 'ألعاب إلكترونية'], true);
  many('فئة المشاركين', ['رجال', 'نساء', 'مختلط', 'ناشئين'], true);
  one('المستوى', ['هواة', 'محترفين', 'مفتوح للجميع']);
  one('نظام البطولة', ['خروج المغلوب', 'دوري', 'مجموعات ثم إقصائيات'], true);

  section('3. المشاركون');
  text('عدد الفرق أو اللاعبين المتوقع', true);
  text('عدد اللاعبين في كل فريق (أساسيون + احتياط)');
  many('طريقة التسجيل', ['دعوات', 'تسجيل مفتوح', 'تسجيل إلكتروني']);
  one('رسوم الاشتراك', ['مجانية', 'مدفوعة']);
  text('مبلغ رسوم الاشتراك (إن وجدت)');
  para('شروط المشاركة (العمر، الهوية، التأمين...)');

  section('4. المواعيد والمدة');
  form.addDateItem().setTitle('التاريخ المقترح لبداية البطولة').setRequired(true);
  text('عدد أيام البطولة', true);
  many('الأوقات المفضلة', ['صباحي', 'مسائي', 'نهاية الأسبوع فقط']);
  text('عدد المباريات في اليوم');
  para('مواعيد يجب تجنبها (رمضان، اختبارات، مناسبات)');

  section('5. الملعب');
  one('هل الملعب متوفر عند العميل؟', ['نعم', 'لا، نحن نوفّره']);
  text('الموقع المفضل (المدينة أو الحي)');
  text('عدد الملاعب المطلوبة');
  many('نوع الملعب', ['مفتوح', 'مغلق', 'عشب طبيعي', 'عشب صناعي']);
  many('المرافق المطلوبة', ['إنارة', 'غرف تبديل', 'مدرجات', 'مواقف', 'دورات مياه', 'منطقة VIP'], true);

  section('6. فريق التنظيم والتحكيم');
  text('عدد المنظمين المطلوب');
  one('الحكام', ['معتمدون', 'غير معتمدين']);
  text('عدد الحكام');
  para('إدارة البطولة (مدير، منسقون، مسجّل نتائج)');
  one('الأمن وتنظيم الدخول', ['مطلوب', 'غير مطلوب']);
  many('الإسعاف أو الفريق الطبي', ['سيارة إسعاف', 'مسعف', 'غير مطلوب']);

  section('7. الجوائز والتكريم');
  text('عدد المراكز المكرّمة');
  many('نوع الجوائز', ['مالية', 'كؤوس', 'ميداليات', 'هدايا عينية'], true);
  many('جوائز فردية', ['الهداف', 'أفضل لاعب', 'أفضل حارس', 'اللعب النظيف'], true);
  one('حفل ختامي', ['نعم', 'لا']);

  section('8. التجهيزات والخدمات');
  one('الأطقم (التيشيرتات)', ['نحن نوفّرها', 'الفرق توفّرها']);
  para('الكرات والأدوات الرياضية المطلوبة');
  many('الضيافة', ['مياه', 'وجبات', 'عصائر', 'ركن قهوة'], true);
  many('الصوت والشاشات', ['مذيع / معلّق', 'لوحة نتائج', 'شاشة عرض']);
  para('الخيام والمظلات والتبريد');

  section('9. الإعلام والتسويق');
  many('التصوير', ['فوتوغرافي', 'فيديو', 'بث مباشر']);
  one('التغطية على السوشال ميديا', ['مطلوبة', 'غير مطلوبة']);
  many('التصاميم المطلوبة', ['شعار البطولة', 'بوسترات', 'بنرات', 'رول أب'], true);
  one('الرعاة', ['موجودون', 'يحتاج العميل مساعدتنا في جلبهم', 'لا يوجد رعاة']);
  one('حضور الجمهور', ['مفتوح', 'بدعوات', 'بدون جمهور']);

  section('10. الميزانية والتصاريح');
  text('الميزانية التقريبية', true);
  one('طريقة الدفع', ['دفعة مقدمة', 'على مراحل']);
  one('من يستخرج التصاريح الرسمية (البلدية، الاتحاد، الجهات الأمنية)؟', ['العميل', 'نحن']);
  one('التأمين على اللاعبين والحضور', ['مطلوب', 'غير مطلوب']);

  section('11. ملاحظات إضافية');
  para('طلبات خاصة أو أفكار عند العميل');
  text('اسم مسؤول التواصل من جهة العميل', true);
  text('رقم الجوال', true);

  form.setConfirmationMessage('شكراً لك! استلمنا بياناتك وسنتواصل معك قريباً بعرض البطولة.');

  Logger.log('رابط تعديل النموذج: ' + form.getEditUrl());
  Logger.log('رابط إرسال النموذج للعميل: ' + form.getPublishedUrl());
}
